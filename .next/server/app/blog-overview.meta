{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/blog-overview/layout,_N_T_/blog-overview/page,_N_T_/blog-overview"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/blog-overview/__PAGE__",
    "/blog-overview",
    "/_index",
    "/_head"
  ]
}